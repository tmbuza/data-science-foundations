# =====================================================
# Quarto build and cache artifacts
# =====================================================

.quarto/
_cache/
_freeze/
_site/
**/*.quarto_ipynb

# Ignore rendered HTML outside docs/
*.html
!docs/**/*.html

# Ignore Quarto-generated asset folders outside docs/
*_files/
!docs/**/*_files/
!docs/**/*_files/**

# Ignore generated document formats
*.pdf
*.docx

# =====================================================
# Python environments and generated files
# =====================================================

.venv/
__pycache__/
*.py[cod]
*.egg-info/

# =====================================================
# Jupyter checkpoints
# =====================================================

.ipynb_checkpoints/

# =====================================================
# Operating system and editor files
# =====================================================

.DS_Store
Thumbs.db
.vscode/
.idea/

# =====================================================
# Logs
# =====================================================

*.log
/.quarto/
